{
  "info": {
    "name": "Cedar Cup demo HTTP QA",
    "description": "Synthetic local demo only. Requests exercise the existing form endpoints and independently read the rendered match and standings responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    }
  ],
  "item": [
    {
      "name": "A01 — Seeded match/result read",
      "description": "R-01 / M01",
      "item": [
        {
          "name": "Reset to Viewer and seeded 2–1",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/reset"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 303\", () => {",
                  "  pm.response.to.have.status(303);",
                  "});",
                  "",
                  "pm.test(\"Redirects to the match\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/\");",
                  "});",
                  "",
                  "pm.test(\"Sets the viewer role cookie\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"demo-role=viewer;\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read saved match result",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Saved match is North Owls 2\\u20131 River Foxes\", () => {",
                  "  pm.expect(pm.response.text()).to.include(\"<p>North Owls <strong>2–1</strong> River Foxes</p>\");",
                  "});",
                  "",
                  "pm.test(\"Match status is Published\", () => {",
                  "  pm.expect(pm.response.text()).to.include(\"<p>Result status: Published</p>\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read saved standings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/standings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"North Owls has 1 win, 0 draws, 0 loss, and 3 points\", () => {",
                  "  pm.expect(pm.response.text()).to.include(\"<tr><th scope=\\\"row\\\">North Owls</th><td>1</td><td>0</td><td>0</td><td>3</td></tr>\");",
                  "});",
                  "",
                  "pm.test(\"River Foxes has 0 win, 0 draws, 1 loss, and 0 points\", () => {",
                  "  pm.expect(pm.response.text()).to.include(\"<tr><th scope=\\\"row\\\">River Foxes</th><td>0</td><td>0</td><td>1</td><td>0</td></tr>\");",
                  "});",
                  "",
                  "pm.test(\"Standings contain exactly two team rows\", () => {",
                  "  const body = pm.response.text().split(\"<tbody>\")[1] || \"\";",
                  "  const rows = body.split(\"</tbody>\")[0].match(/<tr>/g) || [];",
                  "  pm.expect(rows).to.have.lengthOf(2);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
